
pipeline {
    agent any

    stages {
        stage('Afficher un message') {
            steps {
                echo 'Bonjour ! Mon premier pipeline Jenkins'
            }
        }

        stage('Informations du système') {
            steps {
                echo 'Execution du pipeline Jenkins'
            }
        }

        stage('Informations Git') {
            steps {
                echo 'Execution depuis GitHub'
            }
        }
    }
}
echo 'Modification pour tester Poll SCM'
